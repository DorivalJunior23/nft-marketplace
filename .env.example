# Ativa a camada de mocks (MSW) para REST e Socket.IO. Use "true" em dev, demo e testes.
VITE_ENABLE_MOCKS=true
# Base das chamadas REST (relativa ao host da aplicação).
VITE_API_URL=/api
# Endpoint do Socket.IO. Com mocks ativos é interceptado pelo MSW.
VITE_SOCKET_URL=/
# Cenário inicial dos mocks (ver README: seleção e reset de cenários).
VITE_MOCK_SCENARIO=default
